ght: 100%; }\nbody {\n  margin: 0;\n  font: 16px/1.4 system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n  background: var(--bg);\n  color: var(--ink);\n  -webkit-font-smoothing: antialiased;\n  touch-action: manipulation;\n}\nbutton { font: inherit; color: inherit; cursor: pointer; }\n#app { height: 100vh; height: 100dvh; display: flex; }\n#notice {\n  position: fixed; left: 50%; bottom: 14px; transform: translateX(-50%) translateY(8px);\n  background: #34203a; color: #ffd7ea; border: 1px solid #5c3a68; border-radius: 10px;\n  padding: 10px 16px; font-size: 14px; opacity: 0; pointer-events: none; transition: .25s; z-index: 60;\n  max-width: min(92vw, 520px); text-align: center;\n}\n#notice.show { opacity: 1; transform: translateX(-50%); }\n\n.chess-shell { flex: 1; display: flex; flex-direction: column; min-width: 0; min-height: 0; }\n.chess-header {\n  display: flex; align-items: center; gap: 12px; padding: 10px 16px;\n  background: var(--panel); border-bottom: 1px solid var(--line);\n}\n.chess-header .brand { font-size: 11px; letter-spacing: .12em; color: var(--muted); }\n.chess-header h1 { font-size: 18px; margin: 0; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.chess-header .button { flex-shrink: 0; }\n.button {\n  background: var(--panel-2); border: 1px solid var(--line); border-radius: 10px;\n  padding: 8px 14px; font-size: 14px;\n}\n.button.primary { background: var(--accent); border-color: var(--accent); color: #08252e; font-weight: 600; }\n.button:disabled { opacity: .45; cursor: default; }\n\n.chess-status { padding: 6px 16px; font-size: 14px; color: var(--muted); min-height: 28px; }\n.chess-status .announce { color: var(--gold); font-weight: 600; font-size: 16px; }\n.chess-status .alert { color: #ff7286; font-weight: 700; }\n\n.chess-stage { flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; gap: 18px; padding: 12px; position: relative; }\n.chess-canvas {\n  background: var(--board-dark); border: 1px solid var(--line); border-radius: 10px;\n  width: 100%; height: auto;\n  max-width: min(92vw, 640px, calc(100vh - 145px));\n  max-height: calc(100vh - 145px);\n  display: block; touch-action: manipulation;\n}\n.chess-side { display: flex; flex-direction: column; gap: 10px; width: 210px; }\n.chess-player {\n  display: flex; align-items: center; gap: 10px; background: var(--panel);\n  border: 1px solid var(--line); border-radius: 12px; padding: 8px 10px;\n}\n.chess-player.is-turn { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }\n.chess-player.is-winner { border-color: var(--gold); box-shadow: 0 0 0 1px var(--gold); }\n.chess-player img.player-avatar { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; }\n.chess-player .badge { width: 30px; height: 30px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; font-size: 20px; }\n.chess-player .badge.w { background: var(--board-light); color: #3a2c15; }\n.chess-player .badge.b { background: #24160f; color: #e8d0aa; }\n.chess-player .who { flex: 1; min-width: 0; }\n.chess-player .who strong { display: block; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.chess-player .who small { color: var(--muted); font-size: 11px; }\n.chess-player .clock {\n  font-variant-numeric: tabular-nums; font-size: 20px; font-weight: 700;\n  background: var(--panel-2); border-radius: 8px; padding: 4px 8px;\n}\n.chess-player .clock.off { opacity: .55; }\n.chess-player .clock.urgent { color: #ff7286; }\n.chess-history {\n  background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 8px 10px;\n  font-size: 13px; color: var(--muted); max-height: 200px; overflow-y: auto;\n  font-variant-numeric: tabular-nums; line-height: 1.7;\n}\n.chess-history b { color: var(--ink); font-weight: 600; }\n\n.chess-overlay {\n  position: absolute; inset: 0; display: flex; flex-direction: column; gap: 14px;\n  align-items: center; justify-content: center; text-align: center;\n  background: rgba(15, 28, 31, .88); border-radius: 14px; padding: 24px; z-index: 5;\n}\n.chess-overlay .eyebrow { font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: var(--muted); }\n.chess-overlay h2 { margin: 0; font-size: clamp(20px, 4vw, 38px); }\n.chess-overlay .rules { max-width: 560px; color: var(--muted); font-size: 15px; }\n.chess-countdown { font-size: clamp(40px, 10vw, 96px); font-weight: 800; color: var(--accent); }\n.chess-replay { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 10px; }\n.chess-promotion { display: flex; gap: 10px; }\n.chess-promotion .button {\n  width: 64px; height: 64px; font-size: 40px; line-height: 1; padding: 0;\n  display: inline-flex; align-items: center; justify-content: center;\n}\n.chess-footer { display: flex; justify-content: space-between; padding: 8px 16px; font-size: 13px; color: var(--muted); background: var(--panel); border-top: 1px solid var(--line); }\n\n/* Phone: board fills the frame, everything fits without scrolling */\n.controller .chess-header { padding: 6px 10px; gap: 8px; }\n.controller .chess-header .brand { display: none; }\n.controller .chess-header h1 { font-size: 14px; }\n.controller .chess-status { padding: 2px 10px; font-size: 13px; min-height: 20px; }\n.controller .chess-stage { flex-direction: column; gap: 8px; padding: 8px; }\n.controller .chess-side { order: -1; flex-direction: row; width: 100%; gap: 8px; align-items: stretch; }\n.controller .chess-player { flex: 1; padding: 5px 8px; }\n.controller .chess-player .badge { width: 24px; height: 24px; font-size: 16px; }\n.controller .chess-player .who strong { font-size: 12px; }\n.controller .chess-player .clock { font-size: 15px; padding: 3px 6px; }\n.controller .chess-canvas {\n  width: auto; height: auto; max-width: 100%;\n  max-height: calc(100vh - 230px);\n  max-height: calc(100dvh - 230px);\n}\n.controller .chess-history { display: none; }\n.controller .chess-footer { display: none; }\n\n/* Landscape phones: board left, players and status right */\n@media (orientation: landscape) and (max-height: 520px) {\n  .controller .chess-header { display: none; }\n  .controller .chess-stage { flex-direction: row; align-items: stretch; padding: 6px; gap: 8px; }\n  .controller .chess-side { order: 0; flex-direction: column; width: 170px; }\n  .controller .chess-player { flex: none; }\n  .controller .chess-canvas {\n    flex: 1 1 auto; min-width: 40%;\n    width: auto; height: auto; max-width: 100%; max-height: 100%;\n    aspect-ratio: 1 / 1; align-self: center;\n  }\n  .controller .chess-history { display: block; max-height: none; flex: 1; overflow: hidden; }\n}\n\n/* Compact phone header; all controls remain reachable on narrow devices. */\n.chess-header { flex-wrap: wrap; }\n@media(max-width:600px) { .chess-header { padding:6px 10px; gap:6px; } .chess-header h1 { font-size:16px; } .chess-header .brand { display:none; } .chess-header .button { padding:7px; font-size:12px; } }\n\n/* Emerald club: a lit board, quiet surroundings and prominent clocks. */\n:root{--ink:#f0ecda;--muted:#a2b9b0;--bg:#101f23;--panel:#182b2e;--panel-2:#223b3e;--line:#36514f;--accent:#9ce2c6;--gold:#edcc86}\nbody{background:radial-gradient(ellipse at 40% 38%,#31534a 0,transparent 58%),radial-gradient(ellipse at 95% 5%,#554a2b55,transparent 42%),#101f23}\n.chess-header{background:#102125bb;padding:14px 24px;border-bottom:1px solid #c8c8a528;gap:10px}\n.chess-header>div:first-child{flex:1;min-width:0}.chess-header h1{font-family:Georgia,serif;font-weight:normal;font-size:25px;letter-spacing:.01em}\n.chess-header .brand{color:#bca879;font-size:10px;letter-spacing:.2em;margin-bottom:3px}\n.chess-header .button{background:transparent;border-color:#8aab9d45;color:#c9d7ce}\n.chess-status{text-align:center;font-size:17px;padding:9px 16px;color:#c5d9ce;min-height:40px}\n.chess-status .announce{font-size:18px}.chess-status .alert{background:#b