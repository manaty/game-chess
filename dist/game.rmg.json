ont-smoothing: antialiased;\n  touch-action: manipulation;\n}\nbutton { font: inherit; color: inherit; cursor: pointer; }\n#app { height: 100vh; height: 100dvh; display: flex; }\n#notice {\n  position: fixed; left: 50%; bottom: 14px; transform: translateX(-50%) translateY(8px);\n  background: #34203a; color: #ffd7ea; border: 1px solid #5c3a68; border-radius: 10px;\n  padding: 10px 16px; font-size: 14px; opacity: 0; pointer-events: none; transition: .25s; z-index: 60;\n  max-width: min(92vw, 520px); text-align: center;\n}\n#notice.show { opacity: 1; transform: translateX(-50%); }\n\n.chess-shell { flex: 1; display: flex; flex-direction: column; min-width: 0; min-height: 0; }\n.chess-header {\n  display: flex; align-items: center; gap: 12px; padding: 10px 16px;\n  background: var(--panel); border-bottom: 1px solid var(--line);\n}\n.chess-header .brand { font-size: 11px; letter-spacing: .12em; color: var(--muted); }\n.chess-header h1 { font-size: 18px; margin: 0; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.chess-header .button { flex-shrink: 0; }\n.button {\n  background: var(--panel-2); border: 1px solid var(--line); border-radius: 10px;\n  padding: 8px 14px; font-size: 14px;\n}\n.button.primary { background: var(--accent); border-color: var(--accent); color: #08252e; font-weight: 600; }\n.button:disabled { opacity: .45; cursor: default; }\n\n.chess-status { padding: 6px 16px; font-size: 14px; color: var(--muted); min-height: 28px; }\n.chess-status .announce { color: var(--gold); font-weight: 600; font-size: 16px; }\n.chess-status .alert { color: #ff7286; font-weight: 700; }\n\n.chess-stage { flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; gap: 18px; padding: 12px; position: relative; }\n.chess-canvas {\n  background: var(--board-dark); border: 1px solid var(--line); border-radius: 10px;\n  width: 100%; height: auto;\n  max-width: min(92vw, 640px);\n  max-height: 88vh; max-height: 88dvh;\n  display: block; touch-action: manipulation;\n}\n.chess-side { display: flex; flex-direction: column; gap: 10px; width: 210px; }\n.chess-player {\n  display: flex; align-items: center; gap: 10px; background: var(--panel);\n  border: 1px solid var(--line); border-radius: 12px; padding: 8px 10px;\n}\n.chess-player.is-turn { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }\n.chess-player.is-winner { border-color: var(--gold); box-shadow: 0 0 0 1px var(--gold); }\n.chess-player img.player-avatar { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; }\n.chess-player .badge { width: 30px; height: 30px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; font-size: 20px; }\n.chess-player .badge.w { background: var(--board-light); color: #3a2c15; }\n.chess-player .badge.b { background: #24160f; color: #e8d0aa; }\n.chess-player .who { flex: 1; min-width: 0; }\n.chess-player .who strong { display: block; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.chess-player .who small { color: var(--muted); font-size: 11px; }\n.chess-player .clock {\n  font-variant-numeric: tabular-nums; font-size: 20px; font-weight: 700;\n  background: var(--panel-2); border-radius: 8px; padding: 4px 8px;\n}\n.chess-player .clock.off { opacity: .55; }\n.chess-player .clock.urgent { color: #ff7286; }\n.chess-history {\n  background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 8px 10px;\n  font-size: 13px; color: var(--muted); max-height: 200px; overflow-y: auto;\n  font-variant-numeric: tabular-nums; line-height: 1.7;\n}\n.chess-history b { color: var(--ink); font-weight: 600; }\n\n.chess-overlay {\n  position: absolute; inset: 0; display: flex; flex-direction: column; gap: 14px;\n  align-items: center; justify-content: center; text-align: center;\n  background: rgba(15, 28, 31, .88); border-radius: 14px; padding: 24px; z-index: 5;\n}\n.chess-overlay .eyebrow { font-size: 12px