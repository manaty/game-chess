{
  "name": "@manaty/game-chess",
  "version": "1.2.0",
  "type": "module",
  "license": "MIT",
  "description": "Play Chess · Blitz duel together on a shared screen, using phones as controllers. 2 players.",
  "exports": {
    "./engine": "./server/chess.js",
    "./package": "./dist/game.rmg.json",
    "./public/*": "./public/*"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "retro-museum-host --package dist/game.rmg.json",
    "test": "node --test test/*.test.js",
    "test:browser": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@manaty/retro-museum-sdk": "https://github.com/manaty/retro-museum-sdk/archive/39f0deca2c9e2fda284af55ef1bfb0264c313404.tar.gz"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.59.1"
  },
  "engines": {
    "node": ">=22"
  }
}
